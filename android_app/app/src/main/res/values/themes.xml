<resources>
    <style name="Theme.CharacterVault" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg0</item>
        <item name="android:statusBarColor">@color/bg0</item>
        <item name="android:navigationBarColor">@color/bg1</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 7.2: splash screen with the Character Vault mark (static before Android 12). -->
    <style name="Theme.CharacterVault.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CharacterVault</item>
    </style>
</resources>
